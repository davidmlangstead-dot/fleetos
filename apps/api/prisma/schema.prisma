generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DRIVER
  WORKSHOP_TECHNICIAN
  TRANSPORT_PLANNER
  TRANSPORT_MANAGER
  OFFICE_STAFF
  FINANCE
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum VehicleType {
  TRUCK
  VAN
  TRAILER
  CAR
  OTHER
}

enum VehicleStatus {
  ACTIVE
  OFF_ROAD
  SOLD
  ARCHIVED
}

enum JobStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ComplianceStatus {
  ACTIVE
  DUE_SOON
  OVERDUE
  RESOLVED
}

enum DocumentType {
  VEHICLE_DOCUMENT
  DRIVER_DOCUMENT
  POD
  INVOICE
  CERTIFICATE
  SERVICE_RECORD
  OTHER
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  firstName      String?
  lastName       String?
  phone          String?
  avatarUrl      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    CompanyMembership[]
  ownedCompanies Company[]          @relation("CompanyOwner")
}

model Company {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  vatNumber       String?
  address         String?
  postcode        String?
  phone            String?
  ownerId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships     CompanyMembership[]
  vehicles        Vehicle[]
  drivers         Driver[]
  jobs            Job[]
  defects         Defect[]
  complianceItems ComplianceItem[]
  documents       Document[]

  @@index([ownerId])
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Vehicle {
  id                String          @id @default(cuid())
  companyId         String
  registration      String
  type              VehicleType
  status            VehicleStatus   @default(ACTIVE)
  make              String?
  model             String?
  vin               String?
  firstRegisteredAt DateTime?
  acquiredAt        DateTime?
  motDueAt          DateTime?
  serviceDueAt      DateTime?
  inspectionDueAt   DateTime?
  taxDueAt          DateTime?
  insuranceDueAt    DateTime?
  tachoCalibrationDueAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs              Job[]
  defects           Defect[]
  complianceItems   ComplianceItem[]
  documents         Document[]

  @@unique([companyId, registration])
  @@index([companyId])
}

model Driver {
  id             String   @id @default(cuid())
  companyId      String
  userId         String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  licenceNumber  String?
  licenceExpiry  DateTime?
  cpcExpiry      DateTime?
  tachoCardExpiry DateTime?
  medicalExpiry  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs           Job[]
  complianceItems ComplianceItem[]
  documents      Document[]

  @@index([companyId])
}

model Job {
  id          String    @id @default(cuid())
  companyId   String
  vehicleId   String?
  driverId    String?
  reference   String?
  status      JobStatus @default(PLANNED)
  customer    String?
  collection  String?
  delivery    String?
  notes       String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  documents   Document[]

  @@index([companyId])
  @@index([vehicleId])
  @@index([driverId])
}

model Defect {
  id          String       @id @default(cuid())
  companyId   String
  vehicleId   String
  title       String
  description String?
  severity    String?
  status      DefectStatus @default(OPEN)
  reportedAt  DateTime     @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
}

model ComplianceItem {
  id          String           @id @default(cuid())
  companyId   String
  vehicleId   String?
  driverId    String?
  title       String
  category    String?
  dueAt       DateTime?
  status      ComplianceStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver      Driver?          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@index([driverId])
}

model Document {
  id         String       @id @default(cuid())
  companyId  String
  vehicleId  String?
  driverId   String?
  jobId      String?
  type       DocumentType
  name       String
  url        String
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver     Driver?      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  job        Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([jobId])
}
